# Skopiuj ten plik jako .env.local i uzupełnij wartości z Supabase:
# Project Settings → API Keys (adres projektu: Data API → Project URL).

NEXT_PUBLIC_SUPABASE_URL=https://twoj-projekt.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Klucz "secret" — używany tylko na serwerze, do logowania.
# Nazwa MUSI być bez przedrostka NEXT_PUBLIC_, inaczej klucz trafiłby do przeglądarki.
SUPABASE_SECRET_KEY=sb_secret_...
